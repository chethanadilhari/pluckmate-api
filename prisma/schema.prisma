
generator client {
  provider = "prisma-client-js"

}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}


enum UserRole {
  OWNER
  SUPERINTENDENT
}

enum EmployeeRole {
  PLUCKER
  WORKER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
}


model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      UserRole
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile   Profile?

    @@map("users")
}

model Employee {
  id        Int       @id @default(autoincrement())
  firstName      String
  lastName   String
  nic   String @unique
  address String
  phoneNo  String
  joinedDate  DateTime
  role      EmployeeRole
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  attendances Attendance[]
  
    @@map("employees")
}


model Profile {
  id        String   @id @default(uuid())
  fullName  String
  phone     String
  address  String
  updatedAt  DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @unique

    @@map("profiles")
}

model Attendance {
  id         Int       @id @default(autoincrement())
  date       DateTime
  status     AttendanceStatus

  employee   Employee  @relation(fields: [employeeId], references: [id])
  employeeId Int

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([employeeId, date]) // to prevent multiple attendance for same day
  @@map("attendances")
}